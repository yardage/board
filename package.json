{
  "name": "board",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Where a team and their agents think together, in an environment on GitHub. No product code goes through it.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build --logLevel warn && node --disable-warning=ExperimentalWarning src/server/index.ts",
    "serve": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "build": "vite build --logLevel warn && node scripts/bundle.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "board": "node --disable-warning=ExperimentalWarning src/cli/board.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "main": "out/main.cjs"
}
